{
  "name": "vue-message-popup",
  "version": "0.1.0",
  "type": "module",
  "author": {
    "name": "Zaripov Airat",
    "email": "omg.airat@gmail.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && vue-tsc -p tsconfig.build.json",
